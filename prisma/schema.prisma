// 数据模型：旅行计划 / 行程项 / 开销 / 配置
// SQLite 不支持枚举，type 与 category 用字符串常量，取值见 src/types/constants.ts

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  displayName  String?
  isAdmin      Boolean  @default(false)
  disabled     Boolean  @default(false)
  totpSecret   String? // 两步验证密钥（base32）；绑定未验证时也暂存于此
  totpEnabled  Boolean  @default(false)
  createdAt    DateTime @default(now())

  trips  Trip[]
  shares TripShare[]
}

model TripShare {
  id        String   @id @default(cuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  canEdit   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([tripId, userId])
}

model Trip {
  id          String   @id @default(cuid())
  title       String
  destination String
  startDate   DateTime
  endDate     DateTime
  budgetTotal Float?
  notes       String?
  planParams  String? // AI 规划时的参数 JSON（出发地/人数/预算/节奏/偏好/必去地点等），供 AI 助手对话与调整时参考
  ownerId     String? // 首次初始化管理员时认领历史数据，此后必有归属
  owner       User?    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  researchWeb   String?   // 综合网页研究结果（Markdown）
  researchWebAt DateTime?
  researchXhs   String?   // 小红书研究结果（Markdown）
  researchXhsAt DateTime?
  researchAi    String?   // AI 直搜研究结果（Markdown）
  researchAiAt  DateTime?
  shareToken    String?   @unique // 随身行程手册在线分享码（为空 = 未开启）
  shareTokenAt  DateTime? // 分享码生成时间
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items    ItineraryItem[]
  expenses Expense[]
  checklist ChecklistItem[]
  shares   TripShare[]
}

model ItineraryItem {
  id            String  @id @default(cuid())
  tripId        String
  trip          Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  dayIndex      Int
  sortOrder     Int
  type          String // SIGHT | TRANSPORT | HOTEL | FOOD | SHOPPING | OTHER
  title         String
  startTime     String? // "09:30"
  endTime       String?
  placeName     String?
  lng           Float?
  lat           Float?
  address       String?
  estimatedCost Float?
  needBooking   Boolean @default(false) // 是否需要提前预约
  notes         String?
  transportMode String? // 从上一个点到本点的交通方式：line | driving | walking | riding，空 = 跟随全局默认
  aiGenerated   Boolean @default(false)
  guideInfo     String? // AI 生成的地点攻略 JSON（预约/开放时间/门票/贴士等）
  guideAt       DateTime? // 攻略生成时间
  createdAt     DateTime @default(now())

  expenses Expense[]
}

model Expense {
  id           String         @id @default(cuid())
  tripId       String
  trip         Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  date         DateTime
  category     String // TRANSPORT | HOTEL | FOOD | TICKET | SHOPPING | OTHER
  title        String
  amount       Float
  payer        String? // 垫付人（多人分摊用）
  participants String? // 分摊人 JSON 数组，空 = 不参与分摊
  itemId       String?
  item         ItineraryItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)
  notes        String?
  createdAt    DateTime       @default(now())
}

model ChecklistItem {
  id        String   @id @default(cuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  text      String
  checked   Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model Setting {
  key   String @id
  value String
}

model PoiExplorerCache {
  id        String   @id @default(cuid())
  tripId    String
  userId    String
  data      String   // CachePayload JSON
  updatedAt DateTime @updatedAt

  @@unique([tripId, userId])
}

model RouteCache {
  id        String   @id @default(cuid())
  cacheKey  String   @unique
  data      String   // SegRoute JSON，"null" 表示规划失败
  updatedAt DateTime @updatedAt
}
